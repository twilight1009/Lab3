mother (X, Y) :- female(X),  parent(X, Y) .
father (X, Y) :- male (X),  parent(X, Y) .
sister (X, Y) :- female(X),  parent(P, X),  parent (P, Y), X \= Y.
brother (X, Y) :- male(X), parent (P, X),  parent (P, Y), X \= Y.

